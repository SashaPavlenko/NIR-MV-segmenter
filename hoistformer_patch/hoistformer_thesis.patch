+def weighted_dice_loss(inputs: torch.Tensor, targets: torch.Tensor, weights: torch.Tensor, num_masks: float):
+    """dice_loss with a per-row weight (row = one instance on one frame)."""
+    inputs = inputs.sigmoid().flatten(1)
+    numerator = 2 * (inputs * targets).sum(-1)
+    denominator = inputs.sum(-1) + targets.sum(-1)
+    loss = 1 - (numerator + 1) / (denominator + 1)
+    return (loss * weights).sum() / num_masks
+
+
+def weighted_sigmoid_ce_loss(inputs: torch.Tensor, targets: torch.Tensor, weights: torch.Tensor, num_masks: float):
+    """sigmoid_ce_loss with a per-row weight (row = one instance on one frame)."""
+    loss = F.binary_cross_entropy_with_logits(inputs, targets, reduction="none")
+    return (loss.mean(1) * weights).sum() / num_masks
+
